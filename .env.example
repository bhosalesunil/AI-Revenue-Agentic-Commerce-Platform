# Database connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sellpilot?schema=public"

# Razorpay Test Mode Credentials
# Get these from https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpayTestSecretKeyHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# AI / LLM Configuration (Supports Gemini or OpenAI)
AI_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"

# Auth Session Secret
NEXTAUTH_SECRET="sellpilot-super-secure-secret-key-32chars"
NEXTAUTH_URL="http://localhost:3000"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
